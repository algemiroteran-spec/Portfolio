---
import "@fontsource-variable/onest"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import { ViewTransitions } from "astro:transitions"

interface Props {
  title: string
  description: string
  image?: string
  canonical?: string
}

const {
  description,
  title,
  image = "/og-image.webp",
  canonical = Astro.url.href,
} = Astro.props

const siteUrl = "https://algemiroteran.tech"
const ogImage = new URL(image, siteUrl).toString()
const authorName = "Algemiro José Terán Oviedo"

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteUrl}/#person`,
  name: authorName,
  alternateName: "Algemiro Teran",
  url: siteUrl,
  sameAs: [
    "https://linkedin.com/in/algemiro-teran",
    "https://github.com/jokeros121",
  ],
  jobTitle: "Desarrollador Web Full Stack",
  description:
    "Desarrollador Web Full Stack con experiencia en PHP, Laravel, Vue.js y MySQL. Portfolio profesional con proyectos SaaS y sitios web corporativos.",
  image: `${siteUrl}/perfil.jpg`,
  knowsAbout: [
    "PHP", "Laravel", "MySQL", "JavaScript", "Vue.js",
    "Tailwind CSS", "Astro", "HTML5", "CSS3", "Git",
    "REST APIs", "Scrum",
  ],
  alumniOf: [
    {
      "@type": "CollegeOrUniversity",
      name: "Corporación Universitaria del Caribe (CECAR)",
    },
    {
      "@type": "CollegeOrUniversity",
      name: "Universidad Nacional Abierta y a Distancia (UNAD)",
    },
    {
      "@type": "EducationalOrganization",
      name: "Institución Educativa María Inmaculada",
    },
  ],
  hasOccupation: [
    {
      "@type": "Occupation",
      name: "Desarrollador de Software",
      occupationLocation: {
        "@type": "Organization",
        name: "Plaza Educativa GYS S.A.S.",
      },
      startDate: "2025-09",
      endDate: "2026-08",
    },
  ],
  seeks: {
    "@type": "Occupation",
    name: "Desarrollador Web Full Stack",
    description: "Buscando oportunidades como desarrollador full stack con experiencia en Laravel y Vue.js",
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: [
      {
        "@type": "CreativeWork",
        name: "Hoteliums - SaaS de Gestión Hotelera",
        url: "https://hoteliums.app",
        description:
          "Plataforma SaaS multi-tenant para administración integral de hoteles con Laravel y Vue.js",
      },
      {
        "@type": "CreativeWork",
        name: "Ingeniería Proyectos y Servicios",
        url: "https://ingenieriaenproyectosyservicios.com",
        description:
          "Sitio web corporativo de alto rendimiento con Astro y Tailwind CSS",
      },
      {
        "@type": "CreativeWork",
        name: "MS Auditores",
        url: "https://msauditores.netlify.app",
        description:
          "Sitio web institucional para firma de auditoría con Astro y Tailwind CSS",
      },
    ],
  },
}
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="author" content={authorName} />
    <meta name="keywords" content="desarrollador web full stack, PHP, Laravel, Vue.js, MySQL, JavaScript, Colombia, portfolio, SaaS, Tailwind CSS, Astro, desarrollador backend" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <meta name="googlebot" content="index, follow" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Algemiro Terán - Desarrollador Web Full Stack" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Algemiro Terán · Portfolio" />
    <meta property="og:profile:first_name" content="Algemiro" />
    <meta property="og:profile:last_name" content="Terán Oviedo" />
    <meta property="og:profile:username" content="jokeros121" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Algemiro Terán - Desarrollador Web Full Stack" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/perfil.jpg" />
    <meta name="theme-color" content="#0d9488" />
    <meta name="darkreader-lock" />
    <ViewTransitions />
  </head>

  <body class="relative text-slate-800">
    <div
      class="fixed inset-0 z-[-2] bg-gray-50
      bg-[radial-gradient(ellipse_60%_60%_at_50%_0%,rgba(13,148,136,0.25),rgba(255,255,255,0))]"
    >
    </div>
    <div
      class="pointer-events-none fixed inset-0 z-[-1] opacity-[0.015]"
      style="background-image: url('/noise.svg'); background-size: 200px 200px;"
      aria-hidden="true"
    >
    </div>
    <Header />
    <slot />
    <Footer />
    <style is:global>
      :root {
        color-scheme: light;
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        scroll-behavior: smooth;
      }

      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      @keyframes blur {
        to {
          backdrop-filter: blur(20px);
          border-width: 1px;
          border-color: rgba(226, 232, 240, 0.8);
          padding: 0.25rem 0.75rem;
          display: flex;
          flex-direction: row;
          align-items: center;
          background-color: rgba(255, 255, 255, 0.85);
          border-radius: 9999px;
        }
      }

      @keyframes fade-in-up {
        from {
          opacity: 0;
          translate: 0 20px;
        }
        to {
          opacity: 1;
          translate: 0 0;
        }
      }

      .anim-fade-in {
        animation: fade-in-up 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
      }
      .anim-delay-1 { animation-delay: 120ms; }
      .anim-delay-2 { animation-delay: 260ms; }
      .anim-delay-3 { animation-delay: 400ms; }
      .anim-delay-4 { animation-delay: 540ms; }

      .gradient-name {
        background: linear-gradient(135deg, #0f766e 10%, #115e59 60%, #0e7490 90%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        color: transparent;
      }

      @supports (animation-timeline: view()) {
        [data-section] {
          animation: fade-in-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
          animation-timeline: view();
          animation-range: entry 0% entry 18%;
        }

        [data-parallax] {
          animation: parallax-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
          animation-timeline: view();
          animation-range: entry 0% entry 35%;
        }
      }

      @keyframes parallax-in {
        from {
          opacity: 0;
          translate: 0 60px;
          scale: 0.96;
        }
        to {
          opacity: 1;
          translate: 0 0;
          scale: 1;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .anim-fade-in,
        [data-section],
        [data-parallax] {
          animation: none !important;
          opacity: 1 !important;
          translate: none !important;
        }
      }
    </style>
  </body>
</html>
