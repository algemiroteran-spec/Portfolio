---
import LinkInline from "./LinkInline.astro"
import ArrowRight from "./icons/ArrowRight.astro"

interface Props {
  title: string
  company: string
  achievements: string[]
  link?: string
  date: string
  current?: boolean
}

const { title, company, achievements, link, date, current = false } = Astro.props
---

<div
  class="relative mx-12 pb-12 grid before:absolute before:left-[-35px] before:block before:h-full before:border-l-2 before:border-slate-200 before:content-[''] md:grid-cols-5 md:gap-10 md:space-x-4]"
>
  <div class="relative pb-12 md:col-span-2">
    <div class="sticky top-0">
      <div class="flex items-center">
        <span
          class="absolute -left-[42px] flex size-[14px] items-center justify-center"
          aria-hidden="true"
        >
          {current && (
            <span class="animate-ping motion-reduce:animate-none absolute inline-flex size-full rounded-full bg-teal-400/40"></span>
          )}
          <span
            class={`relative inline-flex size-[10px] rounded-full bg-teal-500 ${current ? "shadow-[0_0_8px_2px_rgba(13,148,136,0.45)]" : ""}`}
          ></span>
        </span>
        <h3 class="text-xl font-bold text-teal-600">{title}</h3>
      </div>
      <h4 class="font-semibold text-xl text-slate-800">{company}</h4>
      <time class="p-0 m-0 text-sm text-slate-500">{date}</time>
    </div>
  </div>
  <div class="relative flex flex-col gap-2 pb-4 md:col-span-3">
    <ul class="space-y-2">
      {achievements.map((achievement) => (
        <li class="flex items-start gap-2 text-slate-600">
          <span class="mt-1.5 size-1.5 flex-shrink-0 rounded-full bg-teal-400" aria-hidden="true"></span>
          <span class="text-pretty">{achievement}</span>
        </li>
      ))}
    </ul>
    {
      link && (
        <LinkInline href={link} class="mt-2">
          Saber más sobre {company}{" "}
          <ArrowRight class="size-5" aria-hidden="true" />
        </LinkInline>
      )
    }
  </div>
</div>
