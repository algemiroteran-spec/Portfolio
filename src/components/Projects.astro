---
import ExternalLink from "./icons/ExternalLink.astro"
import GitHub from "./icons/GitHub.astro"
import LinkButton from "./LinkButton.astro"
import AstroIcon from "./icons/Astro.astro"
import LaravelIcon from "./icons/Laravel.astro"
import MySQLIcon from "./icons/MySQL.astro"
import TailwindIcon from "./icons/Tailwind.astro"
import VueIcon from "./icons/Vue.astro"
import projectsData from "@/data/projects.json"

const TAGS: Record<string, { name: string; class: string; icon?: any }> = {
  LARAVEL: {
    name: "Laravel",
    class: "bg-red-50 text-red-700 border border-red-100",
    icon: LaravelIcon,
  },
  VUE: {
    name: "Vue.js",
    class: "bg-emerald-50 text-emerald-700 border border-emerald-100",
    icon: VueIcon,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-cyan-50 text-cyan-700 border border-cyan-100",
    icon: TailwindIcon,
  },
  MYSQL: {
    name: "MySQL",
    class: "bg-blue-50 text-blue-700 border border-blue-100",
    icon: MySQLIcon,
  },
  ASTRO: {
    name: "Astro",
    class: "bg-purple-50 text-purple-700 border border-purple-100",
    icon: AstroIcon,
  },
}

const PROJECTS = projectsData.map((project) => ({
  ...project,
  tags: project.tags.map((key) => TAGS[key]),
}))
---

<div class="flex flex-col gap-y-20">
  {
    PROJECTS.map(({ image, title, description, role, tags, link, github }) => (
    <article class="flex flex-col space-x-0 space-y-6 group md:flex-row md:space-x-10 md:space-y-0">
  <div class="w-full md:w-1/2">
    <a href={link} target="_blank" rel="noopener noreferrer" class="block">
      <div class="relative overflow-hidden rounded-xl border border-slate-200 transition-all duration-300 md:group-hover:-translate-y-1 md:group-hover:shadow-xl md:group-hover:border-teal-300/50">
        <img alt={title} class="w-full aspect-video object-cover rounded-t-xl" loading="lazy" src={image} />
        <div class="absolute inset-0 bg-gradient-to-t from-white/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" aria-hidden="true"></div>
      </div>
    </a>
  </div>

  <div class="w-full md:w-1/2 md:max-w-lg flex flex-col justify-center">
    <p class="text-xs font-medium tracking-wider uppercase text-teal-600 mb-1">{role}</p>
    <h3 class="text-2xl font-bold text-slate-800">
      {title}
    </h3>
    <ul class="flex flex-row flex-wrap mt-3 gap-2">
      {tags.map((tag) => (
        <li>
          <span class={`inline-flex items-center gap-1.5 rounded-full text-xs py-1 px-3 font-medium ${tag.class}`}>
            {tag.icon && <tag.icon class="size-3.5" />}
            {tag.name}
          </span>
        </li>
      ))}
    </ul>

    <p class="mt-3 text-slate-600 text-pretty leading-relaxed">{description}</p>
    <footer class="flex items-center mt-4 gap-x-4">
      {github && (
        <LinkButton href={github}>
          <GitHub class="size-5" />
          Código
        </LinkButton>
      )}
      {link && (
        <LinkButton href={link}>
          <ExternalLink class="size-4" />
          Ver demo
        </LinkButton>
      )}
    </footer>
  </div>
</article>
    ))
  }
</div>
