---
import educationData from "@/data/education.json"
---

<ol class="relative mt-8" aria-label="Formación académica">
  {
    educationData.map((edu, i) => (
      <li class="anim-fade-in" style={`animation-delay: ${i * 150}ms`}>
        <div class="relative mx-12 pb-8 grid before:absolute before:left-[-35px] before:block before:h-full before:border-l-2 before:border-slate-200 before:content-[''] md:grid-cols-5 md:gap-10">
          <div class="relative pb-8 md:col-span-2">
            <div class="sticky top-0">
              <div class="flex items-center">
                <span class="absolute -left-[42px] flex size-[14px] items-center justify-center" aria-hidden="true">
                  <span class="relative inline-flex size-[10px] rounded-full bg-teal-500"></span>
                </span>
                <h3 class="text-xl font-bold text-teal-600">{edu.title}</h3>
              </div>
              <h4 class="font-semibold text-lg text-slate-800">{edu.institution}</h4>
              <time class="p-0 m-0 text-sm text-slate-500">{edu.date}</time>
            </div>
          </div>
          <div class="relative flex flex-col gap-2 pb-2 text-slate-600 text-pretty md:col-span-3">
            {edu.description}
          </div>
        </div>
      </li>
    ))
  }
</ol>
