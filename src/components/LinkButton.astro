---
const { href } = Astro.props;
---

<a
    target="_blank"
    href={href}
    class="inline-flex items-center justify-center gap-2 px-3 py-2 space-x-2 text-base transition bg-white text-slate-700 border border-slate-300 focus-visible:ring-teal-500/80 text-md hover:bg-slate-900 hover:border-slate-900 group max-w-fit rounded-xl hover:text-white focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-white focus-visible:ring-offset-2 active:bg-slate-800"
>
    <slot />
</a>
