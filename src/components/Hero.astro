---
const personalImageAlt = "Algemiro Teran"
import Badge from "@/components/Badge.astro"
import DownloadIcon from "@/components/icons/Download.astro"
import GitHubIcon from "@/components/icons/GitHub.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import SparklesIcon from "@/components/icons/Sparkles.astro"
---

<div class="max-w-2xl">
  <div class="anim-fade-in flex gap-4 mb-6 items-center">
    <div class="relative flex-shrink-0">
      <div
        class="absolute inset-0 rounded-full bg-teal-400/20 blur-xl scale-125"
        aria-hidden="true"
      >
      </div>
      <img
        class="relative rounded-full shadow-lg size-20 ring-2 ring-teal-500/30 ring-offset-2 ring-offset-white"
        src="/perfil.jpg"
        alt={personalImageAlt}
      />
    </div>
    <a
      href="https://linkedin.com/in/algemiro-teran"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center transition md:hover:scale-105"
    >
      <Badge><SparklesIcon class="size-3" /> Disponible para trabajar</Badge>
    </a>
  </div>

  <p
    class="anim-fade-in anim-delay-1 text-sm font-medium tracking-widest uppercase text-teal-600 mb-3"
  >
    Desarrollador Web Full Stack
  </p>

  <h1
    class="anim-fade-in anim-delay-1 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl"
  >
    Algemiro José
    <span class="gradient-name">Terán Oviedo</span>
  </h1>

  <p
    class="anim-fade-in anim-delay-2 mt-6 text-lg text-slate-600 leading-relaxed max-w-xl"
  >
    Construyo aplicaciones web con
    <strong class="text-teal-700 font-semibold">PHP, Laravel y Vue.js</strong>
    que resuelven problemas reales. Con experiencia en
    <strong class="text-teal-700 font-semibold">plataformas SaaS</strong> y
    <strong class="text-teal-700 font-semibold">desarrollo full stack</strong>,
    enfocado en escribir código limpio, mantenible y orientado a resultados.
  </p>

  <nav
    class="anim-fade-in anim-delay-3 flex flex-wrap gap-4 mt-8 items-center"
    aria-label="Contacto y redes"
  >
    <a
      href="mailto:jokeros121@gmail.com"
      class="group inline-flex items-center justify-center gap-2 px-5 py-2.5 text-white bg-teal-600 rounded-lg hover:bg-teal-700 transition-colors font-medium text-sm shadow-sm hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-500 focus-visible:ring-offset-2"
    >
      <MailIcon class="size-4" />
      Contáctame
    </a>
    <a
      href="/cv-algemiro-teran.pdf"
      class="inline-flex items-center justify-center gap-2 px-4 py-2 text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors font-medium text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-500 focus-visible:ring-offset-2"
    >
      <DownloadIcon class="size-4" />
      Descargar CV
    </a>
    <span class="hidden sm:block text-slate-300 mx-1">|</span>
    <a
      href="https://linkedin.com/in/algemiro-teran"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-teal-600 transition-colors"
    >
      <LinkedInIcon class="size-4" />
      LinkedIn
    </a>
    <a
      href="https://github.com/jokeros121"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-teal-600 transition-colors"
    >
      <GitHubIcon class="size-4" />
      GitHub
    </a>
  </nav>
</div>
