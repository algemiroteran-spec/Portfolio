---
const { className } = Astro.props
---

<div class="mb-8">
  <h2
    class={`flex items-center text-3xl font-bold tracking-tight gap-x-3 text-slate-800 ${className ?? ""}`}
  >
    <slot />
  </h2>
  <div
    class="mt-3 h-px w-20 bg-gradient-to-r from-teal-500/70 to-transparent"
    aria-hidden="true"
  >
  </div>
</div>
