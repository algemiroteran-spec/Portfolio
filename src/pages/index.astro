---
import Layout from "@/layouts/Layout.astro"

import AboutMe from "@/components/AboutMe.astro"
import Briefcase from "@/components/icons/Briefcase.astro"
import CodeDots from "@/components/icons/CodeDots.astro"
import ContactCTA from "@/components/ContactCTA.astro"
import Education from "@/components/Education.astro"
import Experience from "@/components/Experience.astro"
import GradCap from "@/components/icons/GradCap.astro"
import Hero from "@/components/Hero.astro"
import Projects from "@/components/Projects.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import SkillsSlider from "@/components/SkillsSlider.astro"
import UserHeart from "@/components/icons/UserHeart.astro"
import TitleSection from "@/components/TitleSection.astro"
---

<Layout
  title="Algemiro Terán | Desarrollador Web Full Stack | PHP Laravel Vue.js MySQL"
  description="Algemiro José Terán Oviedo — Desarrollador Web Full Stack con experiencia en PHP, Laravel, Vue.js y MySQL. Portfolio con proyectos SaaS, sitios web corporativos y plataformas educativas. Disponible para trabajo."
>
  <main class="px-4">
    <SectionContainer class="py-16 md:py-24">
      <Hero />
    </SectionContainer>
    <div class="space-y-24">
      <SectionContainer class="py-10 md:py-12">
        <SkillsSlider />
      </SectionContainer>

      <SectionContainer id="experiencia" data-parallax="true">
        <TitleSection>
          <Briefcase class="size-8" />
          Experiencia
        </TitleSection>
        <Experience />
      </SectionContainer>

      <SectionContainer id="proyectos" data-parallax="true">
        <TitleSection>
          <CodeDots class="size-7" />
          Proyectos
        </TitleSection>
        <Projects />
      </SectionContainer>

      <SectionContainer id="educacion" data-parallax="true">
        <TitleSection>
          <GradCap class="size-7" />
          Educación
        </TitleSection>
        <Education />
      </SectionContainer>

      <SectionContainer id="sobre-mi">
        <TitleSection>
          <UserHeart class="size-8" />
          Sobre mí
        </TitleSection>
        <AboutMe />
      </SectionContainer>

      <SectionContainer class="py-12">
        <ContactCTA />
      </SectionContainer>
    </div>
  </main>
</Layout>
